{% extends 'base.html.twig' %}

{% block title %}Details Livre{% endblock %}

{% block body %}
    {% if book %}
        <h1>Le Livre: {{ book.title }}</h1>
        <span>Auteur: {{ book.author }}</span>
        </br>
        </br>
        </br>
        <a href="{{ path('app_books') }}">
            Retour vers à la liste des livres
        </a>
        {% else %}
        <a href="{{ path('app_books') }}">
            Livre n'existe pas
        </a>
    {% endif %}
{% endblock %}
