<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Mon Projet{% endblock %}</title>

    {# --- Option A : prototypage CDN --- #}
    {# <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script> #}

    {# --- Option B : production, à la place des 2 lignes ci-dessus --- #}
    {# {{ tailwind_css() }} #}

    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="min-h-screen bg-base-200 flex flex-col">

{# ===== NAVBAR ===== #}
<div class="navbar bg-base-100 shadow-sm sticky top-0 z-50">
    <div class="navbar-start">
        <div class="dropdown">
            <div tabindex="0" role="button" class="btn btn-ghost lg:hidden">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16"/></svg>
            </div>
            <ul tabindex="0" class="menu menu-sm dropdown-content bg-base-100 rounded-box z-50 mt-3 w-52 p-2 shadow">
                <li><a href="{{ path('app_home') }}">Accueil</a></li>
                <li><a href="#">Produits</a></li>
            </ul>
        </div>
        <a href="{{ path('app_home') }}" class="btn btn-ghost text-xl">🚀 MonProjet</a>
    </div>

    <div class="navbar-center hidden lg:flex">
        <ul class="menu menu-horizontal px-1">
            <li><a href="{{ path('app_home') }}">Accueil</a></li>
            <li><a href="#">Produits</a></li>
            <li>
                <details>
                    <summary>Admin</summary>
                    <ul class="bg-base-100 rounded-t-none p-2 z-50">
                        <li><a href="#">Utilisateurs</a></li>
                        <li><a href="#">Paramètres</a></li>
                    </ul>
                </details>
            </li>
        </ul>
    </div>

    <div class="navbar-end gap-2">
        {# Toggle thème clair/sombre #}
        <label class="swap swap-rotate btn btn-ghost btn-circle">
            <input type="checkbox" class="theme-controller" value="dark" />
            <svg class="swap-off h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"/></svg>
            <svg class="swap-on h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z"/></svg>
        </label>

        {% if app.user %}
            <div class="dropdown dropdown-end">
                <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar placeholder">
                    <div class="bg-primary text-primary-content w-10 rounded-full">
                        <span>{{ app.user.userIdentifier|slice(0, 1)|upper }}</span>
                    </div>
                </div>
                <ul tabindex="0" class="menu menu-sm dropdown-content bg-base-100 rounded-box z-50 mt-3 w-52 p-2 shadow">
                    <li><a href="#">Profil</a></li>
                    <li><a href="#">Déconnexion</a></li>{# TODO: path('app_logout') #}
                </ul>
            </div>
        {% else %}
            <a href="#" class="btn btn-primary btn-sm">Connexion</a>{# TODO: path('app_login') #}
        {% endif %}
    </div>
</div>

{# ===== FLASH MESSAGES ===== #}
<div class="container mx-auto px-4 mt-4">
    {% for type, messages in app.flashes %}
        {% set alertClass = {
            'success': 'alert-success', 'error': 'alert-error',
            'warning': 'alert-warning', 'info': 'alert-info'
        }[type] ?? 'alert-info' %}
        {% for message in messages %}
            <div role="alert" class="alert {{ alertClass }} mb-2"><span>{{ message }}</span></div>
        {% endfor %}
    {% endfor %}
</div>

{# ===== CONTENU ===== #}
<main class="flex-1 container mx-auto px-4 py-8">
    {% block body %}{% endblock %}
</main>

{# ===== FOOTER ===== #}
<footer class="footer footer-center bg-base-100 text-base-content p-6 border-t border-base-300 mt-auto">
    <aside><p>© {{ 'now'|date('Y') }} MonProjet — Symfony & DaisyUI 💜</p></aside>
</footer>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const html = document.documentElement;
    const saved = localStorage.getItem('theme');
    if (saved) html.setAttribute('data-theme', saved);

    document.querySelectorAll('.theme-controller').forEach((el) => {
        if (el.type === 'checkbox') el.checked = html.dataset.theme === el.value;
        el.addEventListener('change', () => {
            const theme = el.type === 'checkbox' ? (el.checked ? el.value : 'light') : el.value;
            html.setAttribute('data-theme', theme);
            localStorage.setItem('theme', theme);
        });
    });
});
</script>
</body>
</html>
