{% extends 'base.html.twig' %}

{% block title %}Liste des categories{% endblock %}

{% block body %}
<section>
    {% if categories %}
        {% for category in categories %}
            <br>{{category.name}} </br></articles>
            <a href="{{ path('app_category_show', {id: category.id}) }}">
                Voir le détail
            </a><hr>
        {% endfor %}
    {% else %}
        Liste vide.
    {% endif %}
</section>
{% endblock %}
